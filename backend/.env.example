# Copy this file to .env and replace the example secret with a random value:
# openssl rand -hex 32
JWT_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_SESSION_EXPIRE_DAYS=90

# Optional. Defaults to backend/bazaar.db.
# DATABASE_URL=sqlite:///./bazaar.db

# Optional. Existing account with this email is promoted to admin at startup.
# ADMIN_EMAIL=admin@example.com
